# pnpm 11+ project configuration.
# The "pnpm" field in package.json is deprecated; settings live here.
#
# Allow lefthook's postinstall script to run. Without this, 'pnpm install
# --frozen-lockfile' fails with:
#   [ERR_PNPM_IGNORED_BUILDS] Ignored build scripts: lefthook@2.1.9
#
# lefthook's postinstall downloads the native binary used by the local
# git-hooks workflow. The binary lands in node_modules/.bin/lefthook and
# is needed for 'lefthook install' / 'lefthook run pre-commit' etc. Even
# though the Docker image doesn't run git hooks, the binary is required
# for the install itself to succeed under pnpm 11.
only-built-dependencies[]=lefthook
